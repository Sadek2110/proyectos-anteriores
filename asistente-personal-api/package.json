{
  "name": "asistente-personal-api",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "API privada del Asistente Personal de Sadek",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "migrate": "npm run build && node dist/scripts/migrate.js",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "fastify": "5.10.0",
    "pg": "^8.22.0",
    "redis": "^6.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/pg": "^8.20.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
